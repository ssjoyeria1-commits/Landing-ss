---
// Símbolo de SS Joyería redibujado a partir del logo: siete rombos en contorno.
// Medidas tomadas de la imagen original (símbolo de 464 × 721 px). El color sale de `currentColor`.

interface Props {
  /** 'completo': símbolo + SS + JOYERÍA. 'simbolo': solo los rombos. */
  variante?: 'completo' | 'simbolo';
  /** Alto del símbolo. */
  alto?: string;
  class?: string;
  /** Entrada al cargar: los rombos aparecen uno a uno de arriba abajo y luego el texto. */
  animado?: boolean;
  /** Luz dorada que cruza el logo de izquierda a derecha (3 s y 1 s de pausa), después de la entrada. */
  brillo?: boolean;
}

const { variante = 'completo', alto = '4rem', class: clase, animado = false, brillo = false } = Astro.props;
// La luz empieza cuando el logo ya se armó (último rombo y texto terminan a los ~2,1 s).
const INICIO_BRILLO = '2.3s';

const R = 106.5; // semidiagonal exterior de cada rombo
const r = 63.5; // semidiagonal interior (grosor del trazo: 43 px en vertical)
const centros = [
  [232, 106.5],
  [106.5, 233.5],
  [357.5, 233.5],
  [232, 360.5],
  [106.5, 487.5],
  [357.5, 487.5],
  [232, 614.5],
];
const rombo = ([x, y]: number[]) =>
  `M${x} ${y - R}L${x + R} ${y}L${x} ${y + R}L${x - R} ${y}Z` +
  `M${x} ${y - r}L${x - r} ${y}L${x} ${y + r}L${x + r} ${y}Z`;
// Un trazo por rombo (en orden de arriba abajo) para poder animarlos por separado.
const rombos = centros.map(rombo);
// Silueta de los 7 rombos como máscara de la capa de luz (data URI, igual en todos los navegadores).
const mascara = `url("data:image/svg+xml,${encodeURIComponent(
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 464 721"><path fill-rule="evenodd" d="${rombos.join('')}"/></svg>`,
)}")`;
---

<div class:list={['logo', variante, clase, { animado, brillo }]} style={`--alto: ${alto}; --brillo-inicio: ${INICIO_BRILLO}`}>
  <span class="simbolo">
    <svg viewBox="0 0 464 721" role="img" aria-label="SS Joyería" fill="currentColor" fill-rule="evenodd">
      {rombos.map((d, i) => <path d={d} style={`--i: ${i}`} />)}
    </svg>
    {/* Luz dorada sobre los rombos: una capa con la misma luz del texto, recortada a su silueta. */}
    {brillo && <span class="luz" aria-hidden="true" style={`-webkit-mask-image: ${mascara}; mask-image: ${mascara}`} />}
  </span>
  {
    variante === 'completo' && (
      <div class="texto" aria-hidden="true">
        <span class="ss">SS</span>
        <span class="joyeria">Joyería</span>
      </div>
    )
  }
</div>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    color: var(--rojo);
    font-family: var(--serif, Georgia, serif);
    line-height: 1;
  }

  .simbolo {
    position: relative;
    display: inline-block;
    line-height: 0;
  }

  svg {
    height: var(--alto);
    width: auto;
  }

  .texto {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: calc(var(--alto) * 0.08);
  }

  .ss {
    font-size: calc(var(--alto) * 0.42);
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .joyeria {
    margin-top: calc(var(--alto) * 0.06);
    padding-left: 0.45em; /* compensa el espaciado de la última letra */
    font-size: calc(var(--alto) * 0.16);
    letter-spacing: 0.45em;
    text-transform: uppercase;
  }

  /* Cada rombo gira un cuarto de vuelta y crece hasta su sitio, 150 ms después del anterior,
     como una piedra que se engasta; al final sube el texto. Una vez, al cargar. */
  @keyframes rombo-engastar {
    from {
      opacity: 0;
      transform: rotate(-90deg) scale(0.4);
    }
  }

  @keyframes texto-subir {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  .animado path {
    transform-box: fill-box;
    transform-origin: center;
    animation: rombo-engastar 1000ms cubic-bezier(0.16, 1, 0.3, 1) backwards;
    animation-delay: calc(var(--i) * 150ms);
  }

  .animado .texto {
    animation: texto-subir 1000ms cubic-bezier(0.16, 1, 0.3, 1) 1100ms backwards;
  }

  /* Con movimiento reducido: un fundido corto de todo el logo, sin giros. */
  @media (prefers-reduced-motion: reduce) {
    .animado path,
    .animado .texto {
      animation: aparecer 200ms ease-out backwards;
    }
  }

  /* Luz dorada sobre los rombos: capa encima del símbolo, recortada a la silueta de los 7 rombos
     (máscara en el atributo style), con la misma luz y el mismo ritmo que el texto. Antes de
     empezar, la luz queda fuera del símbolo y la capa no se ve. */
  .luz {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
        100deg,
        transparent 0%,
        transparent 40%,
        #d9b45a 46%,
        #fff1c2 50%,
        #d9b45a 54%,
        transparent 60%,
        transparent 100%
      )
      100% 0 / 300% 100%;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    animation: logo-brillo 4s ease-in-out var(--brillo-inicio) infinite backwards;
  }

  /* Luz dorada sobre el texto, al mismo ritmo que la del símbolo: cruza en 3 s y descansa 1 s. */
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .brillo .ss,
    .brillo .joyeria {
      color: transparent;
      background: linear-gradient(
          100deg,
          var(--rojo) 0%,
          var(--rojo) 40%,
          #d9b45a 46%,
          #fff1c2 50%,
          #d9b45a 54%,
          var(--rojo) 60%,
          var(--rojo) 100%
        )
        100% 0 / 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      animation: logo-brillo 4s ease-in-out var(--brillo-inicio) infinite backwards;
    }
  }

  @keyframes logo-brillo {
    0% {
      background-position: 100% 0;
    }
    75%,
    100% {
      background-position: 0% 0;
    }
  }

  /* Sin luz con movimiento reducido. */
  @media (prefers-reduced-motion: reduce) {
    .luz {
      display: none;
    }

    .brillo .ss,
    .brillo .joyeria {
      animation: none;
      color: var(--rojo);
      background: none;
    }
  }
</style>
