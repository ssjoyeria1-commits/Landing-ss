---
import { peso, type PiezaPublica } from '../../lib/caja';

interface Props {
  piezas: PiezaPublica[];
}

const { piezas } = Astro.props;
---

<ul class="piezas">
  {
    piezas.map((p) => (
      <li>
        <span class="descripcion">{p.descripcion}</span>
        <span class="detalle">
          {peso(p.peso_gramos)} · {p.ley}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .piezas {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
  }

  li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    justify-content: space-between;
    padding: 0.75rem 0;
    border-top: 1px solid var(--borde);
  }

  li:last-child {
    border-bottom: 1px solid var(--borde);
  }

  .descripcion {
    font-weight: 600;
  }

  .detalle {
    color: var(--oro);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
