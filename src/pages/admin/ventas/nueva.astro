---
import Admin from '../../../layouts/Admin.astro';
import FormularioVenta from '../../../components/admin/FormularioVenta.astro';
import { hoyBogota } from '../../../lib/formato';
import { leerCobro, leerFormularioVenta, leerVentaAliado } from '../../../lib/venta';
import { listaPaises, partesWhatsapp } from '../../../lib/whatsapp';
import { mensajeError, type UnidadDetalle } from '../../../lib/inventario';

let error = '';

if (Astro.request.method === 'POST') {
  const quiereJson = Astro.request.headers.get('Accept')?.includes('application/json');
  const form = await Astro.request.formData();
  // Venta a un aliado (a su precio, sin cliente, sin chip y pendiente de pago) o a un cliente.
  const esAliado = form.get('tipo') === 'aliado';
  const leido = esAliado ? leerVentaAliado(form) : leerFormularioVenta(form);
  const cobro = leerCobro(form);

  if ('error' in leido) {
    error = leido.error;
  } else if ('error' in cobro) {
    error = cobro.error;
  } else {
    const { data, error: fallo } = esAliado
      ? await Astro.locals.supabase.rpc('registrar_venta_aliado', { p: leido.payload })
      : await Astro.locals.supabase.rpc('registrar_venta', { p: leido.payload });
    if (fallo) {
      error = esAliado ? mensajeError(fallo.message) : fallo.message;
    } else {
      // Medio de pago y domicilio (la base calcula la comisión). Si fallara, la venta ya quedó
      // guardada y estos datos se corrigen en su detalle.
      const { error: falloCobro } = await Astro.locals.supabase.from('ventas').update(cobro.cobro).eq('id', data.venta_id);
      const destino = `/admin/ventas/${data.venta_id}?${esAliado ? 'aliado' : 'nueva'}=1${falloCobro ? '&cobro=error' : ''}`;
      if (quiereJson) return Response.json({ ok: true, destino });
      return Astro.redirect(destino);
    }
  }
  if (quiereJson) return Response.json({ ok: false, error }, { status: 422 });
}

// Piezas disponibles del inventario, para elegirlas por producto y peso.
const [{ data: dataUnidades }, { data: dataAliados }, { data: dataMedios }] = await Promise.all([
  Astro.locals.supabase
    .from('unidades_detalle')
    .select('id, producto_id, codigo, producto, categoria, peso_gramos, precio_cop, precio_aliado_cop')
    .eq('estado', 'disponible')
    .order('codigo')
    .order('peso_gramos')
    // Entre piezas iguales sale primero la del lote más antiguo.
    .order('lote_fecha')
    .order('created_at'),
  Astro.locals.supabase.from('aliados').select('id, nombre').eq('activo', true).order('nombre'),
  Astro.locals.supabase.from('medios_pago').select('id, nombre, comision_pct').eq('activo', true).order('orden').order('nombre'),
]);
const mediosPago = (dataMedios ?? []) as { id: string; nombre: string; comision_pct: number }[];
const unidades = (dataUnidades ?? []) as Pick<
  UnidadDetalle,
  'id' | 'producto_id' | 'codigo' | 'producto' | 'categoria' | 'peso_gramos' | 'precio_cop' | 'precio_aliado_cop'
>[];
const aliados = (dataAliados ?? []) as { id: string; nombre: string }[];

const paises = listaPaises();
const hoy = hoyBogota();
// Desde la ficha de un aliado se llega con ?aliado=ID para dejarlo elegido.
const aliadoInicial = aliados.find((a) => a.id === Astro.url.searchParams.get('aliado'))?.id ?? '';
// Desde la ficha de un cliente se llega con ?cliente=ID para dejar su WhatsApp escrito (el formulario
// lo busca y lo muestra como cliente existente).
let clienteInicial: { pais: string; numero: string } | null = null;
const clienteId = Astro.url.searchParams.get('cliente');
if (clienteId && /^[0-9a-f-]{36}$/i.test(clienteId)) {
  const { data } = await Astro.locals.supabase.from('clientes').select('whatsapp').eq('id', clienteId).maybeSingle();
  const partes = data?.whatsapp ? partesWhatsapp(data.whatsapp as string) : null;
  if (partes) clienteInicial = { pais: partes.pais, numero: partes.nacional };
}
const tipoInicial: 'cliente' | 'aliado' = aliadoInicial || Astro.url.searchParams.get('tipo') === 'aliado' ? 'aliado' : 'cliente';
---

<Admin title="Registrar venta">
  <FormularioVenta {error} {unidades} {aliados} {mediosPago} {paises} {hoy} {aliadoInicial} {clienteInicial} tipoInicial={tipoInicial} />
</Admin>
