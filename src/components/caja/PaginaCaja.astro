---
// Cuerpo de la página del chip: compra propia, regalo, caja de premio del Círculo o página neutra. Lo usan /c/[codigo] y la
// página de datos de prueba (/pruebas/casos), para que las dos muestren exactamente lo mismo.
// La garantía no va aquí: las piezas llevan al certificado (/c/[codigo]/certificado) y, debajo del
// Círculo, un botón lleva a los términos (/garantia).
import Publica from '../../layouts/Publica.astro';
import Piezas from './Piezas.astro';
import Circulo from './Circulo.astro';
import CirculoRegalo from './CirculoRegalo.astro';
import Cuidado from './Cuidado.astro';
import Neutra from './Neutra.astro';
import type { CajaPublica } from '../../lib/caja';
import { capitalizar, primerNombre } from '../../lib/formato';
import { premioTitulo } from '../../config/circulo';

interface Props {
  caja: CajaPublica | null;
  /** Sin caja por un fallo temporal (no porque el código no exista). */
  temporal?: boolean;
  /** Enlace al certificado de esta caja. */
  enlaceCertificado?: string;
}

const { caja, temporal = false, enlaceCertificado = '' } = Astro.props;
// Nivel del Círculo de una caja de premio: 3 → 1, 5 → 2, 10 → 3.
const nivelPremio = caja?.tipo === 'premio' ? [3, 5, 10].indexOf(caja.hito) + 1 : 0;
---

<Publica noindex>
  {
    caja?.tipo === 'propia' && (
      <Fragment slot="saludo">
        <h1>Hola, {capitalizar(caja.nombre)}</h1>
        <p>Eres parte de la familia SS.</p>
      </Fragment>
    )
  }
  {
    caja?.tipo === 'regalo' && (
      <Fragment slot="saludo">
        <h1>{caja.nombre_destinatario ? `Hola, ${capitalizar(primerNombre(caja.nombre_destinatario))}` : 'Hola'}</h1>
        {caja.mensaje && <p class="mensaje-regalo">{caja.mensaje}</p>}
        <p>Te lo regala {capitalizar(caja.nombre_comprador)}.</p>
      </Fragment>
    )
  }
  {
    caja?.tipo === 'premio' && (
      <Fragment slot="saludo">
        <h1>¡Felicitaciones, {capitalizar(caja.nombre)}!</h1>
        <p>Llegaste al nivel {nivelPremio} del Círculo SS.</p>
      </Fragment>
    )
  }
  {
    caja ? (
      <>
        {/* Orden: las piezas (o el premio) con su certificado, el Círculo y el cuidado. */}
        <section class="seccion destacada">
          {caja.tipo === 'premio' ? (
            <>
              <h2>Tu premio</h2>
              <ul class="piezas premio">
                <li>
                  <span class="descripcion">{premioTitulo(caja.hito)}</span>
                  <span class="detalle">{caja.detalle ?? `Premio del nivel ${nivelPremio} del Círculo SS`}</span>
                </li>
              </ul>
            </>
          ) : (
            <>
              <h2>{caja.piezas.length === 1 ? 'Tu pieza' : 'Tus piezas'}</h2>
              <Piezas piezas={caja.piezas} />
            </>
          )}
          {enlaceCertificado && (
            <a class="boton boton-certificado" href={enlaceCertificado}>
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 2.5 19.5 10 12 17.5 4.5 10Z" />
                <path d="M8.5 15.5 7 21.5l5-2.5 5 2.5-1.5-6" stroke-linejoin="round" />
              </svg>
              Ver tu certificado
            </a>
          )}
        </section>
        {caja.tipo !== 'regalo' ? (
          <Circulo circulo={caja.circulo} />
        ) : (
          <CirculoRegalo comprador={capitalizar(caja.nombre_comprador)} codigoReferido={caja.codigo_referido_comprador} />
        )}
        <a class="boton boton-terminos aparece" href="/garantia">Ver términos de garantía</a>
        <Cuidado />
      </>
    ) : (
      <Neutra temporal={temporal} />
    )
  }
</Publica>

<style>
  /* El premio en la franja: el nombre grande con la luz dorada (como las piezas) y el detalle debajo. */
  .piezas.premio {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .piezas.premio li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .piezas.premio .descripcion {
    font-family: var(--display);
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }

  .piezas.premio .detalle {
    color: var(--gris);
  }

  /* Mensaje del comprador en la bienvenida del regalo: en la letra de la marca, en cursiva y entre
     comillas, como una tarjeta escrita a mano; respeta los saltos de línea que escribió. */
  :global(.saludo) p.mensaje-regalo {
    max-width: 24rem;
    margin: 0.4rem auto 1.1rem;
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.35;
    color: var(--tinta);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  :global(.saludo) p.mensaje-regalo::before {
    content: '“';
  }

  :global(.saludo) p.mensaje-regalo::after {
    content: '”';
  }

  /* El certificado es la puerta a algo de valor: filete dorado en vez de marfil. */
  .boton.boton-certificado {
    max-width: 20rem;
    margin: 2.5rem auto 0;
    font-family: var(--display);
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    color: #f3dc9a;
    background: rgb(0 0 0 / 0.35);
    box-shadow: inset 0 0 0 1px rgb(217 180 90 / 0.65);
  }

  /* Debajo del Círculo, discreto: lleva a los términos de la garantía. */
  .boton.boton-terminos {
    margin-top: -0.5rem;
    min-height: 2.75rem;
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--gris);
    background: transparent;
  }
</style>
