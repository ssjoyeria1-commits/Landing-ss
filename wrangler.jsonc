{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ss-joyeria-landing",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Límite de intentos por IP (src/lib/limite.ts). Cada contador es por ubicación de Cloudflare y
  // aproximado: frena abusos, no es un conteo exacto. El periodo solo puede ser 10 o 60 segundos.
  "ratelimits": [
    { "name": "LIMITE_CHIP", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "LIMITE_LOGIN", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  // No son secretos: la clave publicable solo permite lo que dejan las políticas RLS.
  "vars": {
    "SUPABASE_URL": "https://dtwlwoyvpcpbaswbkanx.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_o0AFzSGPL8dxtmIqEfO7jA_WhyScc1o"
  }
}
