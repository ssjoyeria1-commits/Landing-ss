---
// Cuerpo de Ajustes de contabilidad (lo usan /admin/contabilidad/ajustes y la prueba /pruebas/ajustes).

export type MedioPago = { id: string; nombre: string; comision_pct: number; activo: boolean };
export type CategoriaGasto = { id: string; nombre: string; activa: boolean };

interface Props {
  error: string;
  aviso: string;
  medios: MedioPago[];
  categorias: CategoriaGasto[];
}
const { error, aviso, medios, categorias } = Astro.props;
---

  <p><a href="/admin/contabilidad">← Contabilidad</a></p>
  {error && <p class="aviso error">{error}</p>}
  {aviso && <p class="aviso ok">{aviso}</p>}

  <section class="tarjeta">
    <h2 style="margin-top: 0">Medios de pago</h2>
    <p class="ayuda">
      La comisión es el % que cobra el medio sobre lo que paga el cliente (piezas y domicilio). Al cambiarla, las ventas ya
      registradas conservan la que tenían.
    </p>
    {
      medios.map((m) => (
        <form method="post" class="fila linea-ajuste">
          <input type="hidden" name="accion" value="medio-editar" />
          <input type="hidden" name="id" value={m.id} />
          <div class="campo">
            <label for={`medio-${m.id}`}>Nombre</label>
            <input id={`medio-${m.id}`} name="nombre" value={m.nombre} maxlength="40" required />
          </div>
          <div class="campo">
            <label for={`comision-${m.id}`}>Comisión (%)</label>
            <input id={`comision-${m.id}`} name="comision" inputmode="decimal" value={String(m.comision_pct).replace('.', ',')} />
          </div>
          <div class="campo">
            <label class="check"><input type="checkbox" name="activo" checked={m.activo} /> Activo</label>
            <button type="submit" class="secundario">Guardar</button>
          </div>
        </form>
      ))
    }
    <form method="post" class="fila linea-ajuste">
      <input type="hidden" name="accion" value="medio-crear" />
      <div class="campo">
        <label for="medio-nuevo">Nuevo medio</label>
        <input id="medio-nuevo" name="nombre" maxlength="40" placeholder="Bold, Wompi, Addi…" required />
      </div>
      <div class="campo">
        <label for="comision-nuevo">Comisión (%)</label>
        <input id="comision-nuevo" name="comision" inputmode="decimal" placeholder="0" />
      </div>
      <div class="campo" style="align-self: end">
        <button type="submit" class="secundario">Agregar</button>
      </div>
    </form>
  </section>

  <section class="tarjeta">
    <h2 style="margin-top: 0">Categorías de gasto</h2>
    <p class="ayuda">
      Para cambiar un nombre, escríbelo y toca Guardar. Para activar o desactivar, marca las que quieras y usa los botones de abajo. Las inactivas no salen al registrar un gasto; los gastos ya registrados las
      conservan.
    </p>
    <form method="post" id="categorias-lote"></form>
    {
      categorias.map((c) => (
        <form method="post" class:list={['linea-categoria', { inactiva: !c.activa }]}>
          <input type="hidden" name="accion" value="categoria-editar" />
          <input type="hidden" name="id" value={c.id} />
          <input
            type="checkbox"
            form="categorias-lote"
            name="ids"
            value={c.id}
            aria-label={`Marcar ${c.nombre}`}
          />
          <label for={`cat-${c.id}`} class="visualmente-oculto">Nombre</label>
          <input id={`cat-${c.id}`} name="nombre" value={c.nombre} maxlength="60" required />
          {!c.activa && <span class="etiqueta">Inactiva</span>}
          <button type="submit" class="secundario" hidden>Guardar</button>
        </form>
      ))
    }
    <div class="acciones lote">
      <button type="submit" form="categorias-lote" name="accion" value="categorias-desactivar" class="secundario">
        Desactivar seleccionadas
      </button>
      <button type="submit" form="categorias-lote" name="accion" value="categorias-activar" class="secundario">
        Activar seleccionadas
      </button>
    </div>
    <form method="post" class="fila linea-ajuste">
      <input type="hidden" name="accion" value="categoria-crear" />
      <div class="campo" style="grid-column: span 2">
        <label for="cat-nueva">Nueva categoría</label>
        <input id="cat-nueva" name="nombre" maxlength="60" required />
      </div>
      <div class="campo" style="align-self: end">
        <button type="submit" class="secundario">Agregar</button>
      </div>
    </form>
  </section>

<script>
  // El Guardar de cada categoría aparece solo al cambiarle el nombre (en celular no hay espacio para todos).
  for (const form of document.querySelectorAll<HTMLFormElement>('.linea-categoria')) {
    const nombre = form.querySelector<HTMLInputElement>('input[name=nombre]')!;
    const guardar = form.querySelector<HTMLButtonElement>('button')!;
    nombre.addEventListener('input', () => (guardar.hidden = nombre.value === nombre.defaultValue));
  }

</script>

<style>
  .linea-categoria {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    border-top: 1px solid var(--borde);
    padding: 0.5rem 0;
  }

  .linea-categoria input[type='checkbox'] {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin: 0;
  }

  .linea-categoria input[name='nombre'] {
    flex: 1;
    min-width: 0;
  }

  .linea-categoria.inactiva input[name='nombre'] {
    color: var(--suave);
  }

  .linea-categoria button[hidden] {
    display: none;
  }

  .lote {
    border-top: 1px solid var(--borde);
    padding-top: 0.75rem;
  }

  .linea-ajuste {
    align-items: end;
    border-top: 1px solid var(--borde);
    padding-top: 0.6rem;
    margin-top: 0.6rem;
  }

  .linea-ajuste .campo:last-child {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .visualmente-oculto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
