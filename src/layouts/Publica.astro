---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import Pie from '../components/caja/Pie.astro';

interface Props {
  title?: string;
  /** Las páginas de chip llevan noindex. */
  noindex?: boolean;
}

const { title = 'SS Joyería', noindex = false } = Astro.props;
---

<Base title={title} noindex={noindex}>
  <div class="publica">
    <header class="cabecera">
      <Logo alto="4.5rem" />
      {Astro.slots.has('saludo') && <div class="saludo"><slot name="saludo" /></div>}
    </header>
    <main>
      <slot />
    </main>
    <Pie />
  </div>
</Base>

<style is:global>
  .publica {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .publica main {
    flex: 1;
    width: 100%;
    padding-top: 0.25rem;
  }

  .publica .cabecera {
    background: var(--negro);
    color: #fff;
    text-align: center;
    padding: 2rem 1rem 1.75rem;
  }

  .publica .saludo {
    max-width: 32rem;
    margin: 1.5rem auto 0;
  }

  .publica .saludo h1 {
    color: #fff;
    font-size: 2.1rem;
    margin: 0 0 0.35rem;
  }

  .publica .saludo p {
    margin: 0;
    color: #c9c4c2;
  }

  .publica h1,
  .publica h2 {
    font-family: var(--serif);
    font-weight: 600;
  }

  .publica h2 {
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
    color: var(--texto);
  }

  /* Línea roja corta bajo cada título de sección, como acento de marca. */
  .publica .seccion h2::after {
    content: '';
    display: block;
    width: 2rem;
    height: 3px;
    margin-top: 0.45rem;
    background: var(--rojo);
  }

  .publica .seccion {
    background: #fff;
    border: 1px solid var(--borde);
    border-radius: 12px;
    padding: 1.25rem;
    margin: 1rem 0;
  }

  .publica .sutil {
    color: var(--suave);
    font-size: 0.95rem;
  }

  .publica .boton {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .publica .boton.whatsapp,
  .publica .boton.principal {
    color: #fff;
    background: var(--negro);
  }

  .publica .boton.rojo {
    background: var(--rojo);
  }

  .publica .boton.secundario {
    color: var(--texto);
    background: transparent;
    border: 1px solid var(--borde);
  }

  .publica .boton + .boton {
    margin-top: 0.6rem;
  }

  .publica a {
    color: var(--rojo);
  }
</style>
