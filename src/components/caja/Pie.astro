---
import Logo from '../Logo.astro';
import { SITIO } from '../../config/sitio';
import { TEXTOS } from '../../config/textos';
---

<footer class="pie">
  <Logo variante="simbolo" alto="2.75rem" />
  <p>{TEXTOS.etiquetar}</p>
  <p class="enlaces">
    <a href={SITIO.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
    <a href={SITIO.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a>
  </p>
  <p class="enlaces legal">
    <a href="/datos">Política de tratamiento de datos</a>
    <a href="/garantia">Garantía</a>
  </p>
</footer>

<style>
  .pie {
    width: 100%;
    max-width: 30rem;
    margin: 0 auto;
    padding: 3.5rem 0 3rem;
    text-align: center;
    color: var(--gris);
  }

  .enlaces {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 1.5rem;
    margin: 0;
  }

  /* Área táctil de 44 px aunque el texto sea pequeño. */
  .enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  .legal {
    font-size: 0.9rem;
  }
</style>
