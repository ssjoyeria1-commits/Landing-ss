---
import BotonWhatsApp from './BotonWhatsApp.astro';
import LogoCirculo from './LogoCirculo.astro';
import { animo, gramos as verGramos, numeroNivel, PREMIOS, TOPE } from '../../config/circulo';
import { MENSAJES } from '../../config/mensajes';
import { TEXTOS } from '../../config/textos';
import type { CajaPropia } from '../../lib/caja';

interface Props {
  circulo: CajaPropia['circulo'];
}

const { hitos, proximo_hito, codigo_referido } = Astro.props.circulo;
const gramos = Number(Astro.props.circulo.gramos);
const faltan = proximo_hito === null ? 0 : proximo_hito - gramos;
// Nivel ya alcanzado (0 antes de los 5 g). Los premios se suman ("10 balines más"), así que se nombra el nivel.
const nivelActual = hitos.filter((h) => h <= gramos).length;
// Con los 15 g completos solo quedan el símbolo en oro (más grande), el mensaje y el código.
const completo = proximo_hito === null;
// Solo la barra del nivel que se está llenando: va del hito anterior (0, 5 o 10 g) al siguiente; `lleno` de 0 a 1.
const tramo = (() => {
  const i = hitos.findIndex((h) => gramos < h);
  if (i < 0) return null;
  const desde = i === 0 ? 0 : hitos[i - 1];
  const hasta = hitos[i];
  return { nivel: i + 1, desde, hasta, lleno: Math.min(1, Math.max(0, (gramos - desde) / (hasta - desde))) };
})();
const compartir = `https://wa.me/?text=${encodeURIComponent(MENSAJES.compartir(codigo_referido))}`;
---

<section class="bloque">
  <h2 class="titulo-fuera">Tu Círculo SS</h2>
  <div class:list={['seccion circulo', { completo }]}>
    {/* Avance hacia el próximo nivel: una barra del hito anterior al siguiente que se llena en dorado cuando entra en
        pantalla (y la cifra sube a la par). */}
    {!completo && (
      <div
        class="avance"
        role="progressbar"
        aria-valuemin="0"
        aria-valuemax={TOPE}
        aria-valuenow={gramos}
        aria-valuetext={`${verGramos(gramos)} de ${TOPE} g`}
      >
        <p class="cifra">
          <strong data-gramos={gramos} data-desde={tramo?.desde ?? 0}>{gramos.toLocaleString('es-CO', { maximumFractionDigits: 2 })}</strong>
          <span>gramos</span>
        </p>
        {tramo && (
          <div class="tramo actual" aria-hidden="true" style={`--lleno: ${tramo.lleno}`}>
            <span class="barra">
              <span class="relleno" />
            </span>
            <span class="extremos">
              <span>{tramo.desde} g</span>
              <span class="meta">
                <span class="rombo" />
                Nivel {tramo.nivel} · {tramo.hasta} g
              </span>
            </span>
          </div>
        )}
      </div>
    )}

    {/* El símbolo de SS como avance: el rombo de abajo (nivel 1), los cuatro de abajo (nivel 2) o todo en oro (15 g). */}
    <div class="logo-avance">
      <LogoCirculo {gramos} alto={completo ? '13rem' : '10rem'} />
    </div>

    {
      proximo_hito === null ? (
        <p class="siguiente">
          Completaste todos los niveles del Círculo SS. <strong>Eres parte de la ÉLITE.</strong>
        </p>
      ) : nivelActual > 0 ? (
        <p class="siguiente">
          Ya llegaste al <strong>nivel {nivelActual}</strong>. Te faltan {verGramos(faltan)} para el nivel{' '}
          {numeroNivel(proximo_hito)}: <strong>{PREMIOS[proximo_hito]}</strong>.
        </p>
      ) : (
        <p class="siguiente">
          Te faltan {verGramos(faltan)} para el nivel {numeroNivel(proximo_hito)}:{' '}
          <strong>{PREMIOS[proximo_hito]}</strong>.
        </p>
      )
    }

    {animo(gramos) && <p class="animo">{animo(gramos)}</p>}

    {/* La explicación de cómo funciona solo para quien empieza (antes del primer premio, 5 g). */}
    {gramos < 5 && <p class="sutil">{TEXTOS.circuloIntro}</p>}

    <button type="button" class="codigo" data-codigo={codigo_referido} aria-label={`Copiar el código ${codigo_referido}`}>
      <span class="sutil">Tu código de referido</span>
      <span class="valor">{codigo_referido}</span>
      <span class="sutil aviso" aria-live="polite">Toca para copiar</span>
    </button>

    {!completo && <BotonWhatsApp href={compartir} texto="Compartir mi código" color="rojo" />}
  </div>
</section>

<script>
  // Llenado de la barra del Círculo: arranca la primera vez que la barra se ve (el Círculo suele estar más abajo
  // de las piezas). La barra llena tardaría LLENA ms (la del cliente, su parte; al menos MINIMO) y la cifra sube a
  // la par, desde el hito anterior hasta sus gramos. Sin IntersectionObserver o con "reducir movimiento", la barra
  // ya se ve llena (no se toca nada).
  const LLENA = 4000;
  const MINIMO = 2000;
  const formato = new Intl.NumberFormat('es-CO', { maximumFractionDigits: 2 });
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const avance of document.querySelectorAll<HTMLElement>('.circulo .avance')) {
      const cifra = avance.querySelector<HTMLElement>('[data-gramos]')!;
      const total = Number(cifra.dataset.gramos);
      const desde = Number(cifra.dataset.desde);
      const tramo = avance.querySelector<HTMLElement>('.tramo');
      if (!tramo) continue;
      const lleno = Number(getComputedStyle(tramo).getPropertyValue('--lleno')) || 0;
      const duracion = lleno > 0 ? Math.max(lleno * LLENA, MINIMO) : 0;
      tramo.style.setProperty('--dura', `${duracion}ms`);
      tramo.style.setProperty('--empieza', '0ms');
      avance.classList.add('listo');
      cifra.textContent = formato.format(desde);

      const observador = new IntersectionObserver(
        (entradas) => {
          if (!entradas.some((e) => e.isIntersecting)) return;
          observador.disconnect();
          avance.classList.add('en-vista');
          const t0 = performance.now();
          const subir = (ahora: number) => {
            const p = Math.min(1, (ahora - t0) / (duracion || 1));
            cifra.textContent = formato.format(desde + (total - desde) * p);
            if (p < 1) requestAnimationFrame(subir);
          };
          requestAnimationFrame(subir);
        },
        { threshold: 0.6 },
      );
      observador.observe(avance);
    }
  }

  for (const boton of document.querySelectorAll<HTMLButtonElement>('.circulo .codigo')) {
    const aviso = boton.querySelector('.aviso')!;
    let espera: ReturnType<typeof setTimeout>;
    boton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(boton.dataset.codigo!);
        aviso.textContent = 'Copiado';
      } catch {
        aviso.textContent = 'No se pudo copiar';
      }
      clearTimeout(espera);
      espera = setTimeout(() => (aviso.textContent = 'Toca para copiar'), 2000);
    });
  }
</script>

<style>
  .avance {
    margin: 0 0 1.75rem;
  }

  .cifra {
    margin: 0 0 1rem;
    color: var(--gris);
  }

  /* El número en marfil, no en rojo: un 0 rojo se leería como error. */
  .cifra strong {
    display: block;
    font-family: var(--display);
    font-size: 4rem;
    font-weight: 600;
    line-height: 1;
    color: var(--tinta);
    /* Cifras de caja alta: en Cormorant, el 0 y el 1 de estilo antiguo parecen letras. */
    font-variant-numeric: lining-nums tabular-nums;
  }

  .barra {
    position: relative;
    display: block;
    height: 1.25rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(242 236 228 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(242 236 228 / 0.14);
  }

  /* El relleno dorado crece de izquierda a derecha. Con JavaScript (.listo) empieza vacío y, al verse la barra
     (.en-vista), se llena hasta donde va el cliente (--empieza y --dura los pone el script). */
  .relleno {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #b8892f, #f3dc9a 55%, #d9b45a);
    transform: scaleX(var(--lleno));
    transform-origin: left;
  }

  .listo .relleno {
    transform: scaleX(0);
  }

  .listo.en-vista .relleno {
    transform: scaleX(var(--lleno));
    transition: transform var(--dura) linear var(--empieza);
  }

  /* El tramo en curso: un brillo que lo recorre de punta a punta de vez en cuando (la luz dorada de la
     marca), también por la parte que falta por llenar. */
  .actual .barra::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(100deg, transparent 30%, rgb(255 240 200 / 0.7) 50%, transparent 70%);
    transform: translateX(-100%);
    animation: tramo-brillo 2.6s ease-in-out 2.4s infinite;
  }

  /* Con el llenado animado, la luz espera a que el tramo termine de llenarse. */
  .listo:not(.en-vista) .actual .barra::after {
    animation: none;
  }

  .listo.en-vista .actual .barra::after {
    animation-delay: calc(var(--empieza) + var(--dura) + 400ms);
  }

  @keyframes tramo-brillo {
    60%,
    100% {
      transform: translateX(100%);
    }
  }

  /* Debajo de la barra: de dónde parte (el nivel anterior) y a qué nivel llega. */
  .extremos {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.55rem;
    font-size: 0.85rem;
    line-height: 1.2;
    color: var(--gris);
    font-variant-numeric: lining-nums;
  }

  .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--tinta);
    font-weight: 600;
  }

  .rombo {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    transform: rotate(45deg);
    box-shadow: inset 0 0 0 1px #e8c46f;
  }

  @media (prefers-reduced-motion: reduce) {
    .relleno,
    .actual .barra::after {
      animation: none;
    }
  }

  .logo-avance {
    margin: 0.5rem 0 2rem;
  }

  /* Ánimo: en la letra de la marca, en dorado y cursiva, debajo del próximo premio. */
  .animo {
    margin: 0 0 1.25rem;
    font-family: var(--display);
    font-size: 1.45rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.25;
    color: #e8c46f;
  }

  .siguiente {
    margin: 0 0 1rem;
  }

  .codigo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    width: 100%;
    margin-top: 1.75rem;
    padding: 1.25rem 1rem;
    border: 0;
    color: var(--tinta);
    background: var(--superficie);
    box-shadow: var(--filete);
    font: inherit;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
    container-type: inline-size;
  }

  /* Completo: el código pasa a segundo plano, más pequeño. */
  .completo .codigo {
    max-width: 16rem;
    margin: 1.5rem auto 0;
    padding: 0.85rem 1rem;
  }

  .completo .valor {
    font-size: 1.25rem;
    font-size: min(1.4rem, 7cqi);
  }

  .completo .logo-avance {
    margin: 0.5rem 0 1.75rem;
  }

  .completo .siguiente {
    font-size: 1.05rem;
  }

  .codigo:active {
    transform: scale(0.98);
  }

  .valor {
    font-family: var(--display);
    /* Un código no se parte: se achica para caber (el más largo tiene 17 caracteres). */
    font-size: 1.5rem;
    font-size: min(1.9rem, 8.5cqi);
    font-weight: 600;
    font-variant-numeric: lining-nums;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
