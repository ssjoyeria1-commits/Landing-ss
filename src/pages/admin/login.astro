---
import Admin from '../../layouts/Admin.astro';
import { dentroDelLimite } from '../../lib/limite';

if (Astro.locals.usuario) return Astro.redirect('/admin');

let error = '';
let email = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  const password = String(form.get('password') ?? '');

  // Más de 5 intentos por minuto desde la misma IP: ni se pregunta a Supabase.
  if (!(await dentroDelLimite('login', Astro.request))) {
    Astro.response.status = 429;
    Astro.response.headers.set('Retry-After', '60');
    error = 'Demasiados intentos. Espera un minuto y vuelve a intentarlo.';
  } else {
    error = await ingresar(email, password);
    if (!error) return Astro.redirect('/admin');
  }
}

/** Inicia sesión; devuelve el mensaje de error o '' si el usuario es admin. */
async function ingresar(email: string, password: string): Promise<string> {
  const { data, error: fallo } = await Astro.locals.supabase.auth.signInWithPassword({ email, password });
  if (fallo || !data.user) return 'Correo o contraseña incorrectos.';
  const { data: admin } = await Astro.locals.supabase
    .from('admins')
    .select('user_id')
    .eq('user_id', data.user.id)
    .maybeSingle();
  if (admin) return '';
  await Astro.locals.supabase.auth.signOut();
  return 'Este usuario no tiene acceso al panel.';
}
---

<Admin title="Ingresar">
  <form method="post" class="tarjeta" style="max-width: 24rem">
    {error && <p class="aviso error">{error}</p>}
    <div class="campo">
      <label for="email">Correo</label>
      <input id="email" name="email" type="email" autocomplete="username" required value={email} />
    </div>
    <div class="campo">
      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />
    </div>
    <button type="submit">Ingresar</button>
  </form>
</Admin>
