---
import Base from './Base.astro';
import Logo from '../components/Logo.astro';
import Pie from '../components/caja/Pie.astro';
// Única fuente web: Cormorant Garamond (OFL, subconjunto latino, 37 KB). Va a /_astro con caché inmutable.
import fuente from '../assets/fuentes/cormorant-garamond.woff2?url';

interface Props {
  title?: string;
  /** Las páginas de chip llevan noindex. */
  noindex?: boolean;
}

const { title = 'SS Joyería', noindex = false } = Astro.props;
// `swap`: el texto se ve de inmediato con la serif del sistema y cambia cuando llega la fuente.
const caraFuente = `@font-face{font-family:'Cormorant Garamond';src:url('${fuente}') format('woff2');font-weight:500 700;font-display:swap}`;
---

<Base title={title} noindex={noindex} clase="fondo-publico">
  <Fragment slot="head">
    <link rel="preload" href={fuente} as="font" type="font/woff2" crossorigin />
    <style set:html={caraFuente}></style>
  </Fragment>
  <div class="publica">
    <header class="cabecera">
      <Logo alto="6.5rem" />
      {Astro.slots.has('saludo') && <div class="saludo"><slot name="saludo" /></div>}
    </header>
    <main>
      <slot />
    </main>
    <Pie />
  </div>
</Base>

<style is:global>
  /* Dirección "Oscura": un solo fondo negro y cada cosa iluminada como en vitrina.
     El rojo queda para la acción principal y los rombos ganados del Círculo. */
  .fondo-publico {
    background: var(--negro);
    color-scheme: dark;
    -webkit-tap-highlight-color: transparent;
  }

  .publica {
    --display: 'Cormorant Garamond', var(--serif);
    --tinta: #f2ece4;
    --gris: #a39a92;
    --superficie: #131110;
    /* Filete marfil: da forma a botones y tarjetas oscuras sobre el negro. */
    --filete: inset 0 0 0 1px rgb(242 236 228 / 0.35);
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 0 1.5rem;
    color: var(--tinta);
    background: var(--negro);
    line-height: 1.6;
  }

  .publica main {
    flex: 1;
    width: 100%;
    max-width: 30rem;
    padding: 0;
  }

  .publica .cabecera {
    text-align: center;
    padding: 4rem 0 0;
  }

  /* El logotipo toma la fuente de la marca. */
  .publica .logo {
    font-family: var(--display);
  }

  .publica .saludo {
    max-width: 30rem;
    margin: 3rem auto 0;
  }

  .publica h1,
  .publica h2 {
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--tinta);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .publica h1 {
    font-size: 2.75rem;
    line-height: 1.05;
    margin: 0 0 0.5rem;
  }

  .publica .saludo p {
    margin: 0;
    color: var(--gris);
  }

  .publica .seccion {
    text-align: center;
  }

  /* Separador: un rombo del imagotipo antes de cada sección. */
  .publica .seccion::before {
    content: '';
    display: block;
    width: 0.7rem;
    height: 0.7rem;
    margin: 4.5rem auto;
    border: 2px solid var(--rojo);
    transform: rotate(45deg);
  }

  .publica h2 {
    font-size: 2rem;
    line-height: 1.1;
    margin: 0 0 1.75rem;
  }

  .publica p,
  .publica li {
    text-wrap: pretty;
  }

  .publica .sutil {
    color: var(--gris);
    font-size: 0.95rem;
  }

  .publica a {
    color: var(--tinta);
    text-underline-offset: 0.2em;
  }

  .publica .boton {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.25rem;
    margin-top: 1.75rem;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 0;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    color: var(--tinta);
    background: var(--superficie);
    box-shadow: var(--filete);
    transition: transform 160ms var(--ease-out);
  }

  .publica .boton:active {
    transform: scale(0.98);
  }

  .publica .boton.rojo {
    color: #fff;
    background: var(--rojo);
    box-shadow: none;
  }

  .publica .boton + .boton {
    margin-top: 0.6rem;
  }

  .publica :focus-visible {
    outline: 2px solid var(--tinta);
    outline-offset: 3px;
  }

  /* Entrada al abrir la caja: el logo sube y aparece; el saludo lo sigue. Ocurre una vez. */
  @keyframes publica-entrar {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes publica-aparecer {
    from {
      opacity: 0;
    }
  }

  .publica .cabecera > * {
    animation: publica-entrar 500ms var(--ease-out) backwards;
  }

  .publica .cabecera > .saludo {
    animation-delay: 90ms;
  }

  /* Con movimiento reducido: solo un fundido corto, sin desplazamiento. */
  @media (prefers-reduced-motion: reduce) {
    .publica .cabecera > * {
      animation-name: publica-aparecer;
      animation-duration: 200ms;
    }
  }
</style>
