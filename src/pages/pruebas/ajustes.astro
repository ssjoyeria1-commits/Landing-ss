---
// SOLO DESARROLLO: Ajustes de contabilidad con datos de ejemplo, sin sesión ni base de datos. Al enviar
// un formulario muestra lo que llegaría al servidor (no guarda nada). En producción responde 404.
import Admin from '../../layouts/Admin.astro';
import AjustesContables, { type CategoriaGasto, type MedioPago } from '../../components/admin/AjustesContables.astro';

if (import.meta.env.PROD) return new Response(null, { status: 404 });

let aviso = '';
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  aviso = JSON.stringify([...form.entries()].map(([k, v]) => `${k}=${v}`));
}

const medios: MedioPago[] = [
  { id: 'm1', nombre: 'Efectivo', comision_pct: 0, activo: true },
  { id: 'm2', nombre: 'Datáfono', comision_pct: 3.49, activo: true },
];
const categorias: CategoriaGasto[] = [
  'Arriendo', 'Comisiones y gastos bancarios', 'Fotografía y contenido', 'Impuestos y trámites', 'Internet y teléfono',
  'Mantenimiento y reparaciones', 'Otros', 'Papelería y oficina', 'Publicidad y redes', 'Servicios públicos',
].map((nombre, i) => ({ id: `c${i}`, nombre, activa: i !== 3 && i !== 5 }));
---

<Admin title="Ajustes de contabilidad (prueba)">
  <AjustesContables error="" {aviso} {medios} {categorias} />
</Admin>
