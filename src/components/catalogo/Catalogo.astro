---
// Cuerpo de /catalogo: piezas por categoría en una cuadrícula de vitrina. Cada tarjeta lleva la foto
// principal, el nombre y cada peso disponible con su precio (nunca cuántas piezas hay), y abre la
// ficha de la pieza. Lo usan /catalogo y /pruebas/catalogo.
import { peso } from '../../lib/caja';
import { ANCHO, anclaCategoria, type ProductoPublico } from '../../lib/catalogo';
import { pesos } from '../../lib/formato';

interface Props {
  productos: ProductoPublico[];
  /** Sin productos por un fallo temporal (no porque no haya). */
  temporal?: boolean;
  /** Base del enlace de cada ficha (las pruebas usan otra). */
  enlace?: (codigo: string) => string;
}

const { productos, temporal = false, enlace = (c: string) => `/catalogo/${encodeURIComponent(c)}` } = Astro.props;
const VISIBLES = 3;

const categorias = [...new Set(productos.map((p) => p.categoria))];
const porCategoria = categorias.map((nombre) => ({
  nombre,
  ancla: anclaCategoria(nombre),
  productos: productos.filter((p) => p.categoria === nombre),
}));
---

<!-- El título "Catálogo" está en la portada (Publica con rotulo); al deslizar aparecen el subtítulo y las categorías. -->
<header class="encabezado">
  <p class="aparece">Piezas en oro de 18k disponibles hoy. Cada pieza tiene su propio peso, y el precio depende de él.</p>
  {
    categorias.length > 1 && (
      <nav class="categorias aparece" aria-label="Categorías">
        {porCategoria.map((c) => (
          <a href={`#${c.ancla}`}>{c.nombre}</a>
        ))}
      </nav>
    )
  }
</header>

{
  productos.length === 0 && (
    <p class="vacio">
      {temporal
        ? 'No pudimos cargar el catálogo en este momento. Intenta de nuevo en unos minutos.'
        : 'Pronto verás aquí las piezas disponibles.'}
    </p>
  )
}

{
  porCategoria.map((c, ic) => (
    <section class="categoria" id={c.ancla} aria-labelledby={`t-${c.ancla}`}>
      <h2 id={`t-${c.ancla}`}>{c.nombre}</h2>
      <ul class="rejilla">
        {c.productos.map((p, ip) => (
          <li>
            <a class="tarjeta" href={enlace(p.codigo)}>
              <span class="foto">
                <img
                  src={p.fotos[0].mini}
                  srcset={`${p.fotos[0].mini} ${ANCHO.mini}w, ${p.fotos[0].grande} ${ANCHO.grande}w`}
                  sizes="(min-width: 68rem) 16rem, (min-width: 40rem) 30vw, 46vw"
                  alt={p.nombre}
                  width="480"
                  height="600"
                  loading={ic === 0 && ip < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </span>
              <span class="nombre">{p.nombre}</span>
              <span class="precios">
                {p.opciones.slice(0, VISIBLES).map((o) => (
                  <span class="opcion">
                    <span class="peso">{peso(o.peso_gramos)}</span>
                    <span class="precio">{pesos(o.precio_cop)}</span>
                  </span>
                ))}
                {p.opciones.length > VISIBLES && <span class="mas">Ver más pesos</span>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .encabezado {
    text-align: center;
    max-width: 34rem;
    margin: 1rem auto 3rem;
  }

  /* Las categorías entran un poco después del subtítulo. */
  :global(.entrada) .categorias.aparece {
    transition-delay: 150ms;
  }

  .encabezado p {
    margin: 0;
    color: var(--gris);
  }

  /* Categorías: píldoras rojas ajustadas al texto que llevan a su sección. Se envuelven en el
     celular. */
  .categorias {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 0.5rem;
    margin-top: 1.5rem;
  }

  .categorias a {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.3;
    color: #fff;
    background: var(--rojo);
    transition: transform 160ms var(--ease-out);
  }

  /* Área táctil de 44 px de alto aunque la píldora se vea más baja. */
  .categorias a::before {
    content: '';
    position: absolute;
    inset: -0.45rem -0.15rem;
  }

  .categorias a:active {
    transform: scale(0.96);
  }

  /* Los botones de categoría llevan a su sección deslizándose, no de un salto (solo en esta
     página y si el visitante no pidió menos movimiento). */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(.categorias)) {
      scroll-behavior: smooth;
    }
  }

  .vacio {
    text-align: center;
    color: var(--gris);
    font-family: var(--display);
    font-size: 1.45rem;
    margin: 3rem 0;
  }

  .categoria {
    margin: 0 0 3.5rem;
    scroll-margin-top: 1.5rem;
  }

  /* Título de cada categoría: píldora como los botones de arriba, pero más grande y en un rojo
     vino menos intenso; en la letra del texto (no la de las piezas) para que marque el cambio de
     categoría sin confundirse con los nombres. */
  .categoria h2 {
    display: table;
    margin: 0 auto 1.75rem;
    padding: 0.45rem 1.35rem;
    border-radius: 999px;
    font-family: inherit;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.3;
    text-align: center;
    color: var(--tinta);
    background: #7d1822;
    box-shadow: inset 0 0 0 1px rgb(242 236 228 / 0.12);
  }

  /* Dos por fila en el celular, tres en tableta y de ancho fijo en computador. Las filas se
     centran: una pieza sola (o la última de una fila incompleta) no queda cargada a un lado. */
  .rejilla {
    --columnas: 2;
    --hueco: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem var(--hueco);
  }

  .rejilla > li {
    width: calc((100% - (var(--columnas) - 1) * var(--hueco)) / var(--columnas));
  }

  @media (min-width: 40rem) {
    .rejilla {
      --columnas: 3;
      --hueco: 1.75rem;
      row-gap: 2.5rem;
    }
  }

  @media (min-width: 60rem) {
    .rejilla > li {
      width: 15.5rem;
    }
  }

  .tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--tinta);
  }

  /* La foto como tarjeta: un halo marfil grueso y difuminado la despega del fondo negro. */
  .foto {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 10px;
    background: var(--franja);
    box-shadow: var(--halo-foto);
  }

  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  @media (hover: hover) {
    .tarjeta:hover .foto img {
      transform: scale(1.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .foto img {
      transition: none;
    }
  }

  .nombre {
    margin-top: 0.8rem;
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .precios {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.45rem;
    font-size: 0.92rem;
    font-variant-numeric: tabular-nums;
  }

  .opcion {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 0.5rem;
  }

  .peso {
    color: var(--gris);
  }

  .mas {
    color: var(--gris);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
