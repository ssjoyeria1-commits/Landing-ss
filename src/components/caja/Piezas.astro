---
import { peso, type PiezaPublica } from '../../lib/caja';

interface Props {
  piezas: PiezaPublica[];
}

const { piezas } = Astro.props;
---

<ul class="piezas">
  {
    piezas.map((p) => (
      <li>
        <span class:list={["descripcion", { larga: p.descripcion.length > 40 }]}>{p.descripcion}</span>
        <span class="detalle">
          {peso(p.peso_gramos)} · {p.ley}
        </span>
      </li>
    ))
  }
</ul>

<style>
  .piezas {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Cada pieza como objeto de vitrina: el nombre grande y el dato discreto debajo. */
  li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  li + li {
    margin-top: 2rem;
  }

  .descripcion {
    font-family: var(--display);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.15;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .detalle {
    color: var(--gris);
    font-variant-numeric: tabular-nums;
  }
</style>
