---
import BotonWhatsApp from './BotonWhatsApp.astro';
import { PREMIOS, TOPE } from '../../config/circulo';
import { MENSAJES } from '../../config/mensajes';
import { TEXTOS } from '../../config/textos';
import type { CajaPropia } from '../../lib/caja';

interface Props {
  circulo: CajaPropia['circulo'];
}

const { interacciones, hitos, proximo_hito, codigo_referido } = Astro.props.circulo;
const pasos = Array.from({ length: TOPE }, (_, i) => i + 1);
const faltan = proximo_hito === null ? 0 : proximo_hito - interacciones;
const compartir = `https://wa.me/?text=${encodeURIComponent(MENSAJES.compartir(codigo_referido))}`;
---

<section class="seccion circulo">
  <h2>Tu Círculo SS</h2>
  <p class="conteo">
    <strong>{interacciones}</strong>
    <span>de {TOPE} interacciones</span>
  </p>

  <ol class="camino" role="img" aria-label={`Llevas ${interacciones} de ${TOPE} interacciones`}>
    {
      pasos.map((n) => (
        <li class:list={{ hecho: n <= interacciones, hito: hitos.includes(n) }} style={`--i: ${n - 1}`}>
          <span class="punto" />
          {hitos.includes(n) && <span class="numero">{n}</span>}
        </li>
      ))
    }
  </ol>
  <script is:inline>
    if ('IntersectionObserver' in window && document.currentScript.previousElementSibling.querySelector('.hecho'))
      document.currentScript.previousElementSibling.dataset.estado = 'esperando';
  </script>

  {
    proximo_hito === null ? (
      <p class="siguiente">Completaste todos los niveles del Círculo. ¡Gracias por ser parte de SS Joyería!</p>
    ) : (
      <p class="siguiente">
        {faltan === 1 ? 'Te falta 1 interacción' : `Te faltan ${faltan} interacciones`} para el nivel {proximo_hito}:{' '}
        <strong>{PREMIOS[proximo_hito]}</strong>.
      </p>
    )
  }

  <p class="sutil">{TEXTOS.circuloIntro}</p>

  <button type="button" class="codigo" data-codigo={codigo_referido} aria-label={`Copiar el código ${codigo_referido}`}>
    <span class="sutil">Tu código de referido</span>
    <span class="valor">{codigo_referido}</span>
    <span class="sutil aviso" aria-live="polite">Toca para copiar</span>
  </button>

  <BotonWhatsApp href={compartir} texto="Compartir mi código" color="rojo" />
</section>

<script>
  for (const boton of document.querySelectorAll<HTMLButtonElement>('.circulo .codigo')) {
    const aviso = boton.querySelector('.aviso')!;
    let espera: ReturnType<typeof setTimeout>;
    boton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(boton.dataset.codigo!);
        aviso.textContent = 'Copiado';
      } catch {
        aviso.textContent = 'No se pudo copiar';
      }
      clearTimeout(espera);
      espera = setTimeout(() => (aviso.textContent = 'Toca para copiar'), 2000);
    });
  }

  // Los rombos ganados se llenan uno a uno cuando el contador entra en pantalla.
  // Sin JavaScript (o sin IntersectionObserver) se ven llenos desde el principio.
  if ('IntersectionObserver' in window) {
    for (const camino of document.querySelectorAll<HTMLElement>('.circulo .camino[data-estado="esperando"]')) {
      const observador = new IntersectionObserver(
        ([entrada]) => {
          if (!entrada.isIntersecting) return;
          camino.dataset.estado = 'llenando';
          observador.disconnect();
        },
        { threshold: 0.6 },
      );
      observador.observe(camino);
    }
  }
</script>

<style>
  .conteo {
    margin: 0 0 1.5rem;
    color: var(--gris);
  }

  /* El número en marfil, no en rojo: un 0 rojo se leería como error. */
  .conteo strong {
    display: block;
    font-family: var(--display);
    font-size: 5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--tinta);
    /* Cifras de caja alta: en Cormorant, el 0 y el 1 de estilo antiguo parecen letras. */
    font-variant-numeric: lining-nums tabular-nums;
  }

  .camino {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    list-style: none;
    margin: 0 0 2rem;
    padding: 0 0 1.5rem;
  }

  .camino li {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 1.6rem;
  }

  /* Rombos, como los del logo. */
  .punto {
    width: 0.65rem;
    height: 0.65rem;
    border: 2px solid #6f6760;
    transform: rotate(45deg);
  }

  .hito .punto {
    width: 1.1rem;
    height: 1.1rem;
    border-color: var(--tinta);
  }

  .hecho .punto {
    background: var(--rojo);
    border-color: var(--rojo);
  }

  /* Antes de entrar en pantalla, los ganados se ven vacíos; luego se llenan con 60 ms entre uno y otro. */
  .camino[data-estado='esperando'] .hecho:not(.hito) .punto {
    background: transparent;
    border-color: #6f6760;
  }

  .camino[data-estado='esperando'] .hito.hecho .punto {
    background: transparent;
    border-color: var(--tinta);
  }

  @keyframes llenar {
    from {
      opacity: 0;
      transform: rotate(45deg) scale(0.5);
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }

  .camino[data-estado='llenando'] .hecho .punto {
    animation: llenar 260ms var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 60ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .camino[data-estado='llenando'] .hecho .punto {
      animation-name: aparecer;
      animation-delay: 0ms;
    }
  }

  .numero {
    position: absolute;
    top: 1.75rem;
    font-size: 0.85rem;
    color: var(--gris);
  }

  .siguiente {
    margin: 0 0 1rem;
  }

  .codigo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    width: 100%;
    margin-top: 1.75rem;
    padding: 1.25rem 1rem;
    border: 0;
    color: var(--tinta);
    background: var(--superficie);
    box-shadow: var(--filete);
    font: inherit;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
    container-type: inline-size;
  }

  .codigo:active {
    transform: scale(0.98);
  }

  .valor {
    font-family: var(--display);
    /* Un código no se parte: se achica para caber (el más largo tiene 17 caracteres). */
    font-size: 1.5rem;
    font-size: min(1.9rem, 8.5cqi);
    font-weight: 600;
    font-variant-numeric: lining-nums;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
