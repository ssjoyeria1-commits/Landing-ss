{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ss-joyeria-landing",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Entrada propia: la de Astro más el contador de intentos (src/worker.ts).
  "main": "./src/worker.ts",
  // Límite de intentos por IP (src/lib/limite.ts): un Durable Object por visitante, con
  // almacenamiento SQLite (el que permite el plan gratis).
  "durable_objects": {
    "bindings": [{ "name": "CONTADOR", "class_name": "ContadorIntentos" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContadorIntentos"] }],
  // No son secretos: la clave publicable solo permite lo que dejan las políticas RLS.
  "vars": {
    "SUPABASE_URL": "https://dtwlwoyvpcpbaswbkanx.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_o0AFzSGPL8dxtmIqEfO7jA_WhyScc1o"
  }
}
