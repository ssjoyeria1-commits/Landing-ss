---
import Base from './Base.astro';
import Pie from '../components/caja/Pie.astro';

interface Props {
  title?: string;
  /** Las páginas de chip llevan noindex. */
  noindex?: boolean;
}

const { title = 'SS Joyería', noindex = false } = Astro.props;
---

<Base title={title} noindex={noindex}>
  <div class="publica">
    <header class="marca">
      <span class="logo">SS</span>
      <span class="nombre">Joyería</span>
    </header>
    <main>
      <slot />
    </main>
    <Pie />
  </div>
</Base>

<style is:global>
  .publica {
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    --oro: #b08a3e;
    --tarjeta: #fff;
    min-height: 100vh;
  }

  .publica main {
    padding-top: 0.5rem;
  }

  .publica .marca {
    display: flex;
    gap: 0.4rem;
    align-items: baseline;
    justify-content: center;
    padding: 1.25rem 1rem 0.5rem;
    font-family: var(--serif);
    color: var(--rojo);
  }

  .publica .marca .logo {
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .publica .marca .nombre {
    font-size: 1.1rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .publica h1,
  .publica h2 {
    font-family: var(--serif);
    font-weight: 600;
  }

  .publica h1 {
    font-size: 2rem;
    margin: 0.5rem 0 0.25rem;
  }

  .publica h2 {
    font-size: 1.35rem;
    margin: 0 0 0.75rem;
    color: var(--texto);
  }

  .publica .seccion {
    background: var(--tarjeta);
    border: 1px solid var(--borde);
    border-radius: 14px;
    padding: 1.25rem;
    margin: 1rem 0;
  }

  .publica .sutil {
    color: var(--suave);
    font-size: 0.95rem;
  }

  .publica .boton {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 999px;
    font: inherit;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .publica .boton.whatsapp {
    color: #fff;
    background: #1f8f4e;
  }

  .publica .boton.principal {
    color: #fff;
    background: var(--rojo);
  }

  .publica .boton.secundario {
    color: var(--texto);
    background: transparent;
    border: 1px solid var(--borde);
  }

  .publica .boton + .boton {
    margin-top: 0.6rem;
  }

  .publica a {
    color: var(--rojo);
  }
</style>
