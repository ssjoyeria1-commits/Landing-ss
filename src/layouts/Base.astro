---
interface Props {
  title: string;
  description?: string;
  /** Las páginas de chip no deben aparecer en buscadores. */
  noindex?: boolean;
}

const { title, description = 'SS Joyería', noindex = false } = Astro.props;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#000000" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* Colores de marca: rojo medido en el logo digital (referencia impresa: Pantone 7620 C) y negro. */
    --rojo: #d0041a;
    --negro: #000;
    --texto: #141414;
    --suave: #5c5757;
    --fondo: #f6f4f2;
    --borde: #e4dfdc;
    --serif: 'Iowan Old Style', 'Palatino Linotype', Palatino, 'Book Antiqua', Georgia, serif;
    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    color: var(--texto);
    background: var(--fondo);
    line-height: 1.5;
  }

  main {
    max-width: 32rem;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  h1 {
    color: var(--rojo);
    line-height: 1.2;
  }
</style>
