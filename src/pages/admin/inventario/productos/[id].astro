---
// Crear (/admin/inventario/productos/nuevo) o editar un producto del catálogo.
import Admin from '../../../../layouts/Admin.astro';
import { fecha, pesos } from '../../../../lib/formato';
import {
  gramos,
  leerProducto,
  mensajeError,
  MOTIVOS_BAJA,
  type AjusteDetalle,
  type Categoria,
  type ProductoCatalogo,
  type UnidadDetalle,
} from '../../../../lib/inventario';
import type { PiezaVendida } from '../../../../lib/informes';

const supabase = Astro.locals.supabase;
const id = Astro.params.id ?? '';
const nuevo = id === 'nuevo';
let error = '';
let aviso = Astro.url.searchParams.get('aviso') ?? '';
let enviado: FormData | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const accion = String(form.get('accion') ?? 'guardar');

  if (accion === 'baja' || accion === 'reintegro') {
    // Bajas y reintegros de piezas sueltas, con motivo (quedan en el historial).
    const unidades = form.getAll('unidades').map(String).filter(Boolean);
    const motivo = String(form.get('motivo') ?? '').trim() || (accion === 'reintegro' ? 'Reintegro' : '');
    if (unidades.length === 0) {
      error = 'Marca al menos una pieza.';
    } else {
      const { data, error: fallo } = await supabase.rpc('ajustar_inventario', {
        p: { tipo: accion, unidades, motivo, nota: String(form.get('nota') ?? '') },
      });
      if (fallo) error = mensajeError(fallo.message);
      else aviso = accion === 'baja' ? `${data} ${data === 1 ? 'pieza dada de baja' : 'piezas dadas de baja'}.` : 'Pieza reintegrada al inventario.';
    }
  } else {
    enviado = form;
    const leido = leerProducto(enviado);
    if ('error' in leido) {
      error = leido.error;
    } else {
      const { error: fallo } = nuevo
        ? await supabase.from('productos').insert(leido.datos)
        : await supabase.from('productos').update(leido.datos).eq('id', id);
      if (fallo) error = mensajeError(fallo.message);
      else return Astro.redirect('/admin/inventario');
    }
  }
}

const { data: dataCategorias } = await supabase
  .from('categorias')
  .select('id, nombre, activa')
  .order('nombre');
const categorias = (dataCategorias ?? []) as Pick<Categoria, 'id' | 'nombre' | 'activa'>[];

let producto: ProductoCatalogo | null = null;
if (!nuevo) {
  const { data } = await supabase.from('productos_catalogo').select('*').eq('id', id).maybeSingle();
  producto = data as ProductoCatalogo | null;
  if (!producto) return new Response(null, { status: 404 });
}

// Todas las piezas de esta referencia (disponibles, vendidas y de baja), sus ventas, ajustes y conteos.
const [{ data: dataPiezas }, { data: dataVendidas }, { data: dataAjustes }, { data: dataConteos }] = nuevo
  ? [{ data: [] }, { data: [] }, { data: [] }, { data: [] }]
  : await Promise.all([
      supabase.from('unidades_detalle').select('*').eq('producto_id', id).order('peso_gramos'),
      supabase.from('piezas_vendidas').select('*').eq('producto_id', id).order('fecha', { ascending: false }).limit(200),
      supabase.from('ajustes_detalle').select('*').eq('producto_id', id).order('created_at', { ascending: false }).limit(200),
      supabase.from('conteos').select('id, fecha, en_sistema, contadas, nota, created_at').eq('producto_id', id).order('created_at', { ascending: false }).limit(50),
    ]);
const todas = (dataPiezas ?? []) as UnidadDetalle[];
const piezas = todas.filter((p) => p.estado === 'disponible');
const deBaja = todas.filter((p) => p.estado === 'baja');
const vendidas = (dataVendidas ?? []) as PiezaVendida[];
const ajustes = (dataAjustes ?? []) as AjusteDetalle[];
const conteos = (dataConteos ?? []) as { id: string; fecha: string; en_sistema: number; contadas: number; nota: string | null; created_at: string }[];

// Historial: entradas por lote, ventas, ajustes y conteos, del más reciente al más antiguo.
type Evento = { cuando: string; fecha: string; texto: string; detalle?: string };
const porLote = new Map<string, { fecha: string; piezas: number; gramos: number; creado: string }>();
for (const p of todas) {
  const l = porLote.get(p.lote_id) ?? { fecha: p.lote_fecha, piezas: 0, gramos: 0, creado: p.lote_fecha };
  l.piezas += 1;
  l.gramos += Number(p.peso_gramos);
  porLote.set(p.lote_id, l);
}
const historial: Evento[] = [
  ...[...porLote.entries()].map(([, l]) => ({
    cuando: `${l.fecha}T00:00:00`,
    fecha: l.fecha,
    texto: `Entrada de ${l.piezas} ${l.piezas === 1 ? 'pieza' : 'piezas'} (${gramos(l.gramos)})`,
  })),
  ...vendidas.map((v) => ({
    cuando: `${v.fecha}T12:00:00`,
    fecha: v.fecha,
    texto: `Venta de ${gramos(v.peso_gramos)} · ${pesos(Number(v.precio_neto_cop ?? 0))}${v.anulada ? ' (anulada)' : ''}`,
    detalle: v.referencia,
  })),
  ...ajustes.map((a) => ({
    cuando: a.created_at,
    fecha: a.created_at.slice(0, 10),
    texto: `${a.tipo === 'baja' ? 'Baja' : 'Reintegro'} de ${gramos(a.peso_gramos)}: ${a.motivo}`,
    detalle: [a.nota, a.creado_por_nombre].filter(Boolean).join(' · '),
  })),
  ...conteos.map((c) => ({
    cuando: c.created_at,
    fecha: c.fecha,
    texto: `Conteo: ${c.contadas} contadas de ${c.en_sistema} en el sistema${c.contadas < c.en_sistema ? ` (faltaron ${c.en_sistema - c.contadas})` : c.contadas > c.en_sistema ? ` (sobraron ${c.contadas - c.en_sistema})` : ''}`,
    detalle: c.nota ?? '',
  })),
].sort((a, b) => b.cuando.localeCompare(a.cuando)).slice(0, 100);

// Si el formulario volvió con error, se conservan los valores escritos.
const valor = (campo: string, original: string | number | null | undefined) =>
  String(enviado ? (enviado.get(campo) ?? '') : (original ?? ''));
---

<Admin title={nuevo ? 'Nuevo producto' : producto!.nombre}>
  <p><a href="/admin/inventario">← Productos</a></p>
  {error && <p class="aviso error">{error}</p>}
  {aviso && <p class="aviso ok">{aviso}</p>}

  {
    categorias.length === 0 ? (
      <p class="tarjeta">
        Primero crea una categoría. <a href="/admin/inventario/categorias">Crear categorías</a>
      </p>
    ) : (
      <form method="post" class="tarjeta">
        <div class="fila">
          <div class="campo">
            <label for="codigo">Código</label>
            <input id="codigo" name="codigo" value={valor('codigo', producto?.codigo)} maxlength="20" placeholder="AN-014" required style="text-transform: uppercase" autocomplete="off" />
            <p class="ayuda">El de la etiqueta. Letras, números y guiones.</p>
          </div>
          <div class="campo" style="grid-column: span 2">
            <label for="nombre">Nombre</label>
            <input id="nombre" name="nombre" value={valor('nombre', producto?.nombre)} maxlength="120" placeholder="Anillo solitario con circón" required autocomplete="off" />
          </div>
        </div>
        <div class="fila">
          <div class="campo">
            <label for="categoria_id">Categoría</label>
            <select id="categoria_id" name="categoria_id" required>
              <option value="">Elige…</option>
              {categorias
                .filter((c) => c.activa || c.id === producto?.categoria_id)
                .map((c) => (
                  <option value={c.id} selected={c.id === valor('categoria_id', producto?.categoria_id)}>
                    {c.nombre}
                  </option>
                ))}
            </select>
          </div>
          <div class="campo">
            <label for="stock_minimo">Stock mínimo</label>
            <input id="stock_minimo" name="stock_minimo" inputmode="numeric" value={valor('stock_minimo', producto?.stock_minimo ?? 0)} />
            <p class="ayuda">Avisa cuando queden menos unidades.</p>
          </div>
        </div>
        <p class="ayuda">El peso no va aquí: cada pieza tiene el suyo y se anota al registrar su lote.</p>
        <div class="campo" style="margin-top: 0.9rem">
          <label for="nota">Nota (opcional)</label>
          <textarea id="nota" name="nota" rows="2">{valor('nota', producto?.nota)}</textarea>
        </div>
        <div class="acciones">
          <label class="check">
            <input type="checkbox" name="activo" checked={enviado ? enviado.get('activo') === 'on' : nuevo || producto!.activo} /> Activo (se puede vender)
          </label>
          <button type="submit">{nuevo ? 'Crear producto' : 'Guardar cambios'}</button>
        </div>
      </form>
    )
  }

  {
    !nuevo && (
      <>
      <section>
        <div class="acciones" style="justify-content: space-between; margin-top: 2rem">
          <h2 style="margin: 0">Piezas disponibles ({piezas.length})</h2>
          {piezas.length > 0 && (
            <a class="boton secundario" href={`/admin/inventario/productos/${id}/conteo`}>
              Contar este producto
            </a>
          )}
        </div>
        {piezas.length === 0 ? (
          <p class="tarjeta">
            No hay piezas disponibles. <a href="/admin/inventario/lotes/nuevo">Registrar lote</a>
          </p>
        ) : (
          <form method="post" id="bajas">
            <input type="hidden" name="accion" value="baja" />
            <div class="tabla">
              <table>
                <thead>
                  <tr>
                    <th />
                    <th class="num">Peso</th>
                    <th class="num">Costo</th>
                    <th class="num">Precio hoy</th>
                    <th>Lote</th>
                  </tr>
                </thead>
                <tbody>
                  {piezas.map((p) => (
                    <tr>
                      <td>
                        <input type="checkbox" name="unidades" value={p.id} aria-label={`Marcar la pieza de ${gramos(p.peso_gramos)}`} />
                      </td>
                      <td class="num">{gramos(p.peso_gramos)}</td>
                      <td class="num">{pesos(p.costo_cop)}</td>
                      <td class="num">{pesos(p.precio_cop)}</td>
                      <td>
                        <a href={`/admin/inventario/lotes/${p.lote_id}`}>{fecha(p.lote_fecha)}</a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <div class="fila" style="margin-top: 0.75rem">
              <div class="campo">
                <label for="motivo">Dar de baja las marcadas por</label>
                <select id="motivo" name="motivo">
                  {MOTIVOS_BAJA.slice(1).map((m) => (
                    <option>{m}</option>
                  ))}
                </select>
              </div>
              <div class="campo" style="grid-column: span 2">
                <label for="nota-baja">Nota (opcional)</label>
                <input id="nota-baja" name="nota" autocomplete="off" />
              </div>
            </div>
            <button type="submit" class="secundario">Dar de baja las marcadas</button>
          </form>
        )}
      </section>

      {deBaja.length > 0 && (
        <section>
          <h2>Piezas dadas de baja ({deBaja.length})</h2>
          <p class="ayuda">Si una aparece, reintégrala y vuelve a estar disponible.</p>
          <div class="tabla">
            <table>
              <thead>
                <tr>
                  <th class="num">Peso</th>
                  <th class="num">Costo</th>
                  <th>Lote</th>
                  <th />
                </tr>
              </thead>
              <tbody>
                {deBaja.map((p) => (
                  <tr>
                    <td class="num">{gramos(p.peso_gramos)}</td>
                    <td class="num">{pesos(p.costo_cop)}</td>
                    <td>{fecha(p.lote_fecha)}</td>
                    <td>
                      <form method="post">
                        <input type="hidden" name="accion" value="reintegro" />
                        <input type="hidden" name="unidades" value={p.id} />
                        <input type="hidden" name="motivo" value="Apareció la pieza" />
                        <button type="submit" class="enlace">Reintegrar</button>
                      </form>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      {historial.length > 0 && (
        <section>
          <h2>Historial</h2>
          <div class="tabla">
            <table>
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Movimiento</th>
                  <th>Detalle</th>
                </tr>
              </thead>
              <tbody>
                {historial.map((e) => (
                  <tr>
                    <td>{fecha(e.fecha)}</td>
                    <td>{e.texto}</td>
                    <td>{e.detalle ? <small>{e.detalle}</small> : null}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}
      </>
    )
  }
</Admin>

<script>
  document.querySelector<HTMLFormElement>('#bajas')?.addEventListener('submit', (e) => {
    const form = e.currentTarget as HTMLFormElement;
    const n = form.querySelectorAll('input[name="unidades"]:checked').length;
    const motivo = form.querySelector<HTMLSelectElement>('[name="motivo"]')!.value;
    if (n === 0) {
      e.preventDefault();
      alert('Marca las piezas que quieres dar de baja.');
    } else if (!confirm(`¿Dar de baja ${n} ${n === 1 ? 'pieza' : 'piezas'} por "${motivo}"? Dejan de estar disponibles para la venta.`)) {
      e.preventDefault();
    }
  });
</script>
