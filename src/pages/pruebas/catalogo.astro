---
// SOLO DESARROLLO: el catálogo con datos de prueba, sin base de datos.
// ?datos=demo|peor|uno|vacio|temporal y ?ficha=CODIGO para ver la ficha de una pieza (o uno que no
// exista para "ya no está disponible"). ?whatsapp=1 muestra el botón con un número de ejemplo. En producción responde 404.
import Publica from '../../layouts/Publica.astro';
import Catalogo from '../../components/catalogo/Catalogo.astro';
import Ficha from '../../components/catalogo/Ficha.astro';
import type { ProductoPublico } from '../../lib/catalogo';

if (import.meta.env.PROD) return new Response(null, { status: 404 });

/** Foto de prueba: una "joya" dorada sobre fondo oscuro, en 4:5 (o 1:1 o 3:2 para probar recortes). */
function foto(tono: number, forma: 'anillo' | 'cadena' | 'aretes', proporcion: [number, number] = [4, 5]) {
  const [w, h] = [proporcion[0] * 100, proporcion[1] * 100];
  const cx = w / 2;
  const cy = h / 2;
  const oro = `hsl(${tono} 70% 58%)`;
  const dibujo = {
    anillo: `<circle cx="${cx}" cy="${cy}" r="${w / 4}" fill="none" stroke="${oro}" stroke-width="${w / 18}"/><path d="M${cx} ${cy - w / 4 - 40}l22 22-22 22-22-22z" fill="#f2ece4"/>`,
    cadena: `<path d="M${w * 0.18} ${h * 0.25}Q${cx} ${h * 0.95} ${w * 0.82} ${h * 0.25}" fill="none" stroke="${oro}" stroke-width="10" stroke-dasharray="14 6"/><path d="M${cx} ${h * 0.6}l30 30-30 30-30-30z" fill="${oro}"/>`,
    aretes: `<circle cx="${cx - w / 6}" cy="${cy}" r="${w / 9}" fill="none" stroke="${oro}" stroke-width="12"/><circle cx="${cx + w / 6}" cy="${cy}" r="${w / 9}" fill="none" stroke="${oro}" stroke-width="12"/>`,
  }[forma];
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${w} ${h}"><defs><radialGradient id="g"><stop offset="0" stop-color="hsl(${tono} 30% 22%)"/><stop offset="1" stop-color="#0b0606"/></radialGradient></defs><rect width="100%" height="100%" fill="url(#g)"/>${dibujo}</svg>`;
  const url = `data:image/svg+xml,${encodeURIComponent(svg)}`;
  return { grande: url, mini: url };
}

const o = (g: number, precioGramo = 420000) => ({ peso_gramos: g, precio_cop: Math.round(g * precioGramo) });

const demo: ProductoPublico[] = [
  { codigo: 'AN-014', nombre: 'Anillo solitario', descripcion: 'Oro amarillo con circón central, acabado brillante.', categoria: 'Anillos', fotos: [foto(42, 'anillo'), foto(38, 'anillo', [1, 1]), foto(46, 'anillo', [3, 2])], opciones: [o(2.1), o(2.45), o(3.02)] },
  { codigo: 'AN-020', nombre: 'Argolla media caña', descripcion: null, categoria: 'Anillos', fotos: [foto(40, 'anillo')], opciones: [o(3.8)] },
  { codigo: 'AN-031', nombre: 'Anillo rombo calado', descripcion: 'Inspirado en el rombo del imagotipo.', categoria: 'Anillos', fotos: [foto(30, 'anillo'), foto(34, 'anillo')], opciones: [o(1.9), o(2.2), o(2.6), o(2.9), o(3.3)] },
  { codigo: 'CA-002', nombre: 'Cadena tejido lazo 50 cm', descripcion: 'Broche de seguridad.', categoria: 'Cadenas', fotos: [foto(44, 'cadena')], opciones: [o(4.5, 380000), o(5.1, 380000)] },
  { codigo: 'CA-008', nombre: 'Cadena con dije de rombo', descripcion: null, categoria: 'Cadenas', fotos: [foto(36, 'cadena'), foto(40, 'cadena')], opciones: [o(3.25, 380000)] },
  { codigo: 'TO-011', nombre: 'Topos de bolita', descripcion: null, categoria: 'Aretes', fotos: [foto(48, 'aretes')], opciones: [o(0.8, 450000), o(1.1, 450000)] },
];

// Peor caso: nombres y categoría largos, descripción de 400 caracteres, 12 pesos y precios altos.
const largo = 'Anillo de compromiso solitario en oro blanco con diamante talla brillante y certificado gemológico';
const peor: ProductoPublico[] = [
  {
    codigo: 'AN-COMPROMISO-01',
    nombre: largo,
    descripcion: 'Pieza hecha a mano. '.repeat(20).trim(),
    categoria: 'Anillos de compromiso y matrimonio',
    fotos: Array.from({ length: 5 }, (_, i) => foto(30 + i * 5, 'anillo', i % 2 ? [3, 2] : [4, 5])),
    opciones: Array.from({ length: 12 }, (_, i) => o(10.5 + i * 1.37, 1250000)),
  },
  ...demo,
];

const casos: Record<string, ProductoPublico[]> = { demo, peor, uno: demo.slice(1, 2), vacio: [], temporal: [] };
const datos = Astro.url.searchParams.get('datos') ?? 'demo';
const productos = casos[datos] ?? demo;
const ficha = Astro.url.searchParams.get('ficha');
const enlace = (c: string) => `/pruebas/catalogo?datos=${datos}&ficha=${encodeURIComponent(c)}`;
const volver = `/pruebas/catalogo?datos=${datos}`;
const producto = ficha ? (productos.find((p) => p.codigo === ficha) ?? null) : null;
---

<Publica title="Catálogo · SS Joyería" noindex amplio portada={!ficha} rotulo={ficha ? undefined : "Catálogo"}>
  {
    ficha ? (
      <Ficha producto={producto} temporal={datos === 'temporal'} volver={volver} numero={Astro.url.searchParams.has('whatsapp') ? '+573001234567' : undefined} />
    ) : (
      <Catalogo productos={productos} temporal={datos === 'temporal'} enlace={enlace} />
    )
  }
</Publica>
