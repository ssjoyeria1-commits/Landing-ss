---
import { TEXTOS } from '../../config/textos';
---

<section class="seccion compacta">
  <h2>Cuida tu pieza</h2>
  <ul class="cuidado">
    {TEXTOS.cuidado.map((t) => <li>{t}</li>)}
  </ul>
</section>

<style>
  .cuidado {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: left;
  }

  li {
    position: relative;
    padding-left: 1.6rem;
  }

  li + li {
    margin-top: 1rem;
  }

  /* Viñeta: rombo en contorno. El rombo rojo macizo queda solo para lo ganado en el Círculo. */
  li::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    border: 1.5px solid var(--gris);
    transform: rotate(45deg);
  }
</style>
