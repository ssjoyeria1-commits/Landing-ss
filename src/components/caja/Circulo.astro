---
import BotonWhatsApp from './BotonWhatsApp.astro';
import LogoCirculo from './LogoCirculo.astro';
import { animo, PREMIOS, TOPE } from '../../config/circulo';
import { MENSAJES } from '../../config/mensajes';
import { TEXTOS } from '../../config/textos';
import type { CajaPropia } from '../../lib/caja';

interface Props {
  circulo: CajaPropia['circulo'];
}

const { interacciones, hitos, proximo_hito, codigo_referido } = Astro.props.circulo;
const faltan = proximo_hito === null ? 0 : proximo_hito - interacciones;
// Premios de los niveles ya alcanzados, en una frase: "A", "A y B", "A, B y C". Vacío antes del nivel 3.
const logrados = new Intl.ListFormat('es', { type: 'conjunction' }).format(
  hitos.filter((h) => h <= interacciones).map((h) => PREMIOS[h] ?? `el premio del nivel ${h}`),
);
const compartir = `https://wa.me/?text=${encodeURIComponent(MENSAJES.compartir(codigo_referido))}`;
---

<section class="bloque">
  <h2 class="titulo-fuera">Tu Círculo SS</h2>
  <div class="seccion circulo">
    <p class="conteo">
      <strong>{interacciones}</strong>
      <span>de {TOPE} interacciones</span>
    </p>

    {/* El símbolo de SS como avance: el rombo de abajo (nivel 1), los cuatro de abajo (nivel 2) o todo en oro (10). */}
    <div class="logo-avance">
      <LogoCirculo {interacciones} alto="10rem" />
    </div>

    {
      proximo_hito === null ? (
        <p class="siguiente">
          Completaste todos los niveles del Círculo y ya has logrado conseguir <strong>{logrados}</strong>. ¡Gracias por
          ser parte de SS Joyería!
        </p>
      ) : logrados ? (
        <p class="siguiente">
          Ya has logrado conseguir <strong>{logrados}</strong>. Ahora estás cerca de alcanzar{' '}
          <strong>{PREMIOS[proximo_hito]}</strong>: {faltan === 1 ? 'te falta 1 interacción' : `te faltan ${faltan} interacciones`}.
        </p>
      ) : (
        <p class="siguiente">
          {faltan === 1 ? 'Te falta 1 interacción' : `Te faltan ${faltan} interacciones`} para el nivel {proximo_hito}:{' '}
          <strong>{PREMIOS[proximo_hito]}</strong>.
        </p>
      )
    }

    {animo(interacciones) && <p class="animo">{animo(interacciones)}</p>}

    <p class="sutil">{TEXTOS.circuloIntro}</p>

    <button type="button" class="codigo" data-codigo={codigo_referido} aria-label={`Copiar el código ${codigo_referido}`}>
      <span class="sutil">Tu código de referido</span>
      <span class="valor">{codigo_referido}</span>
      <span class="sutil aviso" aria-live="polite">Toca para copiar</span>
    </button>

    <BotonWhatsApp href={compartir} texto="Compartir mi código" color="rojo" />
  </div>
</section>

<script>
  for (const boton of document.querySelectorAll<HTMLButtonElement>('.circulo .codigo')) {
    const aviso = boton.querySelector('.aviso')!;
    let espera: ReturnType<typeof setTimeout>;
    boton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(boton.dataset.codigo!);
        aviso.textContent = 'Copiado';
      } catch {
        aviso.textContent = 'No se pudo copiar';
      }
      clearTimeout(espera);
      espera = setTimeout(() => (aviso.textContent = 'Toca para copiar'), 2000);
    });
  }
</script>

<style>
  .conteo {
    margin: 0 0 1.5rem;
    color: var(--gris);
  }

  /* El número en marfil, no en rojo: un 0 rojo se leería como error. */
  .conteo strong {
    display: block;
    font-family: var(--display);
    font-size: 5rem;
    font-weight: 600;
    line-height: 1;
    color: var(--tinta);
    /* Cifras de caja alta: en Cormorant, el 0 y el 1 de estilo antiguo parecen letras. */
    font-variant-numeric: lining-nums tabular-nums;
  }

  .logo-avance {
    margin: 0.5rem 0 2rem;
  }

  /* Ánimo: en la letra de la marca, en dorado y cursiva, debajo del próximo premio. */
  .animo {
    margin: 0 0 1.25rem;
    font-family: var(--display);
    font-size: 1.45rem;
    font-style: italic;
    font-weight: 600;
    line-height: 1.25;
    color: #e8c46f;
  }

  .siguiente {
    margin: 0 0 1rem;
  }

  .codigo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    width: 100%;
    margin-top: 1.75rem;
    padding: 1.25rem 1rem;
    border: 0;
    color: var(--tinta);
    background: var(--superficie);
    box-shadow: var(--filete);
    font: inherit;
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
    container-type: inline-size;
  }

  .codigo:active {
    transform: scale(0.98);
  }

  .valor {
    font-family: var(--display);
    /* Un código no se parte: se achica para caber (el más largo tiene 17 caracteres). */
    font-size: 1.5rem;
    font-size: min(1.9rem, 8.5cqi);
    font-weight: 600;
    font-variant-numeric: lining-nums;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
</style>
